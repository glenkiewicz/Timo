{
  "expo": {
    "name": "Timo",
    "slug": "Timo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "timo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.glenkiewicz.Timo",
      "appleTeamId": "X8BB56BL2A",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2f6b4f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.glenkiewicz.Timo",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff1df",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-audio",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "./plugins/withUISceneLifecycle",
      [
        "expo-image-picker",
        {
          "photosPermission": "Timo potrzebuje dostępu do zdjęć, żeby ustawić zdjęcie jako awatar dziecka. Zdjęcie zostaje tylko na tym telefonie.",
          "cameraPermission": "Timo potrzebuje aparatu, żeby zrobić zdjęcie na awatar dziecka. Zdjęcie zostaje tylko na tym telefonie.",
          "microphonePermission": false
        }
      ],
      "./plugins/withoutPushEntitlement"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "35be7e21-078d-4dfe-96f4-1a189290ae5d"
      }
    },
    "owner": "glenkiewicz"
  }
}
