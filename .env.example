# Konta i ranking — Supabase.
# Skopiuj do `.env` (plik jest w .gitignore) i uzupełnij z panelu projektu:
# Project Settings → API.
#
# Oba klucze są publiczne z założenia — trafiają do aplikacji na telefonie.
# Danych pilnuje RLS po stronie bazy, nie tajność klucza `anon`.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Generator głosu Timo — scripts/generate-timo-voices.ts
# Voice ID: dashboard ElevenLabs → Voices → własny głos Timo.
# Potrzebne TYLKO do regeneracji klipów, aplikacja ich nie używa.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
